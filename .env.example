# Steward — environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# See SETUP.md for how to obtain each value.

# --- AWS ---
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # if using temporary creds
# AWS_PROFILE=steward           # alternatively use a named profile

# --- Bedrock models (confirm exact inference-profile IDs in your account/region) ---
MODEL_HARD=global.anthropic.claude-sonnet-4-6
MODEL_CHEAP=us.amazon.nova-lite-v1:0

# --- DynamoDB tables (see infra/ddb.py) ---
DDB_TRUST_TABLE=steward_trust
DDB_AUDIT_TABLE=steward_audit

# --- Amazon SNS (SMS) — replaces Twilio; boto3 already required, no extra package ---
# SNS SMS works globally with just your existing AWS creds. No phone number to buy.
# Cost: ~$0.00414/msg to India — negligible vs the $50 credit.
SNS_SENDER_ID=Steward       # Alphanumeric sender ID shown on recipient's phone (max 11 chars)
SNS_REGION=us-east-1        # SNS SMS best supported in us-east-1 (can differ from AWS_REGION)
COORDINATOR_PHONE=          # demo coordinator's phone in E.164, e.g. +919876543210

# --- Google Sheets (the org substrate) ---
GOOGLE_SHEET_ID=              # the demo spreadsheet ID
# Local dev: service account (simplest) — download its JSON key, share the Sheet with its email.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# Production (AgentCore Identity Google OAuth provider, P4):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Org identity ---
ORG_ID=demo-pantry           # trust state is keyed on this (institutional persistence, §3.6)

# --- AgentCore (populated after deploy) ---
AGENT_RUNTIME_ARN=
AGENTCORE_MEMORY_ID=
AGENTCORE_GATEWAY_URL=
